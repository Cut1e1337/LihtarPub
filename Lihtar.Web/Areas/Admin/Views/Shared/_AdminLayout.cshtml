<!doctype html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Lihtar Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <div class="lihtar-shell">

        <aside class="lihtar-sidebar">
            <a class="lihtar-logo"
               asp-area="Admin"
               asp-controller="AdminHome"
               asp-action="Index">
                <div class="lihtar-logo-mark">L</div>
                <span>Lihtar Admin</span>
            </a>

            <nav class="lihtar-nav">
                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminHome" ? "active" : "")"
                   asp-area="Admin" asp-controller="AdminHome" asp-action="Index">
                    Головна
                </a>

                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "MenuCategories" ? "active" : "")"
                   asp-area="Admin" asp-controller="MenuCategories" asp-action="Index">
                    Категорії меню
                </a>

                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "MenuItems" ? "active" : "")"
                   asp-area="Admin" asp-controller="MenuItems" asp-action="Index">
                    Позиції меню
                </a>

                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Events" ? "active" : "")"
                   asp-area="Admin" asp-controller="Events" asp-action="Index">
                    Події
                </a>

                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "EventCategories" ? "active" : "")"
                   asp-area="Admin" asp-controller="EventCategories" asp-action="Index">
                    Категорії подій
                </a>

                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Tables" ? "active" : "")"
                   asp-area="Admin" asp-controller="Tables" asp-action="Index">
                    Столики
                </a>

                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "TableBoard" ? "active" : "")"
                   asp-area="Admin" asp-controller="TableBoard" asp-action="Index">
                    Дошка столиків
                </a>

                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservations" ? "active" : "")"
                   asp-area="Admin" asp-controller="Reservations" asp-action="Index">
                    Бронювання
                </a>

                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")"
                   asp-area="Admin" asp-controller="Users" asp-action="Index">
                    Користувачі
                </a>
            </nav>
        </aside>

        <div class="lihtar-main">
            <header class="lihtar-topbar">
                <h1 class="lihtar-page-title">
                    @ViewData["Title"]
                </h1>

                <div class="lihtar-top-actions">
                    <a class="lh-btn"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">
                        На сайт
                    </a>

                    <form asp-area=""
                          asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="d-inline">
                        @Html.AntiForgeryToken()

                        <button class="lh-btn lh-btn-primary" type="submit">
                            Вийти
                        </button>
                    </form>
                </div>
            </header>

            <main class="lihtar-content">
                @RenderBody()
            </main>
        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>