﻿@using Microsoft.AspNetCore.Mvc.Rendering
@model Lihtar.Web.ViewModels.MenuItems.MenuItemEditVm

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var categories = ViewBag.Categories as List<SelectListItem> ?? new();
}

<h2>Edit Menu Item</h2>

<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <!-- ✅ для Edit треба Id -->
    <input type="hidden" name="Id" value="@Model.Id" />

    <!-- ✅ щоб не втратити старе фото, якщо нове не вибрали -->
    <input type="hidden" name="ImageUrl" value="@Model.ImageUrl" />

    <div class="mb-3">
        <label class="form-label">Category</label>

        <select class="form-select" name="MenuCategoryId">
            <option value="">-- Select category --</option>
            @foreach (var c in categories)
            {
                var selected = (c.Value == Model.MenuCategoryId.ToString()) ? "selected" : "";
                <option value="@c.Value" @selected>@c.Text</option>
            }
        </select>

        <small class="text-muted">Loaded categories: @categories.Count</small>
    </div>

    <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" name="Name" value="@Model.Name" />
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea class="form-control" name="Description">@Model.Description</textarea>
    </div>

    <div class="row">
        <div class="col-md-3 mb-3">
            <label class="form-label">Price</label>
            <input class="form-control" name="Price" value="@Model.Price" />
        </div>

        <div class="col-md-3 mb-3">
            <label class="form-label">Calories</label>
            <input class="form-control" name="Calories" value="@(Model.Calories?.ToString() ?? "")" />
        </div>

        <div class="col-md-3 mb-3">
            <label class="form-label">Weight (g)</label>
            <input class="form-control" name="WeightGrams" value="@(Model.WeightGrams?.ToString() ?? "")" />
        </div>

        <div class="col-md-3 mb-3">
            <label class="form-label">Available</label><br />
            <input class="form-check-input" type="checkbox" name="IsAvailable" value="true" @(Model.IsAvailable ? "checked" : "") />
            <input type="hidden" name="IsAvailable" value="false" />
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Photo</label>
        <input class="form-control" type="file" name="ImageFile" accept="image/*" />

        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <div class="mt-2">
                <img src="@Model.ImageUrl" style="max-height:120px;border:1px solid #ddd;border-radius:8px;" />
            </div>
        }
    </div>

    <div class="mb-3">
        <label class="form-label">Tags</label>

        <div class="row">
            @for (int i = 0; i < Model.Tags.Count; i++)
            {
                var cbId = $"tag_{i}";

                <div class="col-md-3 mb-2">
                    <input type="hidden" name="Tags[@i].Id" value="@Model.Tags[i].Id" />
                    <input type="hidden" name="Tags[@i].Name" value="@Model.Tags[i].Name" />

                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="@cbId"
                               name="Tags[@i].Selected"
                               value="true"
                               @(Model.Tags[i].Selected ? "checked" : "") />

                        <input type="hidden" name="Tags[@i].Selected" value="false" />

                        <label class="form-check-label" for="@cbId">
                            @Model.Tags[i].Name
                        </label>
                    </div>
                </div>
            }
        </div>

        <small class="text-muted">Loaded tags: @Model.Tags.Count</small>
    </div>

    <button class="btn btn-success" type="submit">Save</button>
    <a class="btn btn-secondary" href="/Admin/MenuItems">Back</a>
</form>