@model Lihtar.Application.DTOs.TableDto

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Додати столик";
}

<div class="container py-4">
    <h2>Додати столик</h2>

    <form action="/Admin/Tables/Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Номер столика</label>
            <input name="TableNumber" value="@Model.TableNumber" class="form-control" type="number" min="1" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Кількість місць</label>
            <input name="Seats" value="@Model.Seats" class="form-control" type="number" min="1" required />
        </div>

        <div class="form-check mb-3">
            <input name="IsVip" value="true" class="form-check-input" type="checkbox" @(Model.IsVip ? "checked" : "") />
            <label class="form-check-label">VIP столик</label>
        </div>

        <div class="form-check mb-3">
            <input name="IsActive" value="true" class="form-check-input" type="checkbox" @(Model.IsActive ? "checked" : "") />
            <label class="form-check-label">Активний</label>
        </div>

        <button type="submit" class="btn btn-primary">Зберегти</button>
        <a href="/Admin/Tables" class="btn btn-secondary">Назад</a>
    </form>
</div>