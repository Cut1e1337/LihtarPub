@model Lihtar.Application.DTOs.TableDto

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Видалити столик";
}

<div class="container py-4">
    <h2>Видалити столик</h2>

    <div class="alert alert-danger mt-3">
        Ви точно хочете видалити цей столик?
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <p><strong>Номер столика:</strong> №@Model.TableNumber</p>
            <p><strong>Кількість місць:</strong> @Model.Seats</p>
            <p><strong>VIP:</strong> @(Model.IsVip ? "Так" : "Ні")</p>
            <p><strong>Активний:</strong> @(Model.IsActive ? "Так" : "Ні")</p>
        </div>
    </div>

    <form action="/Admin/Tables/DeleteConfirmed/@Model.Id" method="post">
        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-danger">
            Видалити
        </button>

        <a href="/Admin/Tables" class="btn btn-secondary">
            Назад
        </a>
    </form>
</div>