@model Lihtar.Application.DTOs.TableDto

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Редагувати столик";
}

<div class="container py-4">
    <h2>Редагувати столик</h2>

    <form action="/Admin/Tables/Edit" method="post">
        @Html.AntiForgeryToken()

        <input name="Id" value="@Model.Id" type="hidden" />

        <div class="mb-3">
            <label class="form-label">Номер столика</label>
            <input name="TableNumber" value="@Model.TableNumber" class="form-control" type="number" min="1" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Кількість місць</label>
            <input name="Seats" value="@Model.Seats" class="form-control" type="number" min="1" required />
        </div>

        <div class="form-check mb-3">
            <input type="hidden" name="IsVip" value="false" />

            <input class="form-check-input"
                   type="checkbox"
                   id="IsVip"
                   name="IsVip"
                   value="true"
                   @(Model.IsVip ? "checked" : "") />

            <label class="form-check-label" for="IsVip">VIP столик</label>
        </div>

        <div class="form-check mb-3">
            <input type="hidden" name="IsActive" value="false" />

            <input class="form-check-input"
                   type="checkbox"
                   id="IsActive"
                   name="IsActive"
                   value="true"
                   @(Model.IsActive ? "checked" : "") />

            <label class="form-check-label" for="IsActive">Активний</label>
        </div>

        <button type="submit" class="btn btn-primary">Зберегти</button>
        <a href="/Admin/Tables" class="btn btn-secondary">Назад</a>
    </form>
</div>