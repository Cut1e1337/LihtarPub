@model List<Lihtar.Web.Areas.Admin.ViewModels.TableBoard.TableBoardItemVm>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Table Board";
}

<div class="container py-4">

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="mb-0">Table Board</h2>

            <div class="text-muted small">
                Стан столиків у залі на сьогодні
            </div>
        </div>

        <a href="/Admin/Tables"
           class="btn btn-outline-secondary">
            Керування столиками
        </a>
    </div>

    <div class="row g-3">

        @foreach (var table in Model)
        {
            var cardClass = table.Status switch
            {
                "Free" => "border-success",
                "Reserved" => "border-warning",
                "Pending" => "border-info",
                "Busy" => "border-danger",
                "Inactive" => "border-secondary",
                _ => "border-secondary"
            };

            var badgeClass = table.Status switch
            {
                "Free" => "bg-success",
                "Reserved" => "bg-warning text-dark",
                "Pending" => "bg-info text-dark",
                "Busy" => "bg-danger",
                "Inactive" => "bg-secondary",
                _ => "bg-secondary"
            };

            var statusText = table.Status switch
            {
                "Free" => "Вільний",
                "Reserved" => "Заброньований",
                "Pending" => "Очікує підтвердження",
                "Busy" => "Зайнятий",
                "Inactive" => "Неактивний",
                _ => table.Status
            };

            <div class="col-md-4 col-lg-3">

                <div class="card shadow-sm h-100 @cardClass">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-start mb-2">

                            <div>
                                <h4 class="mb-0">№@table.TableNumber</h4>

                                <div class="text-muted small">
                                    @table.Seats місць
                                </div>
                            </div>

                            <span class="badge @badgeClass">
                                @statusText
                            </span>

                        </div>

                        @if (table.IsVip)
                        {
                            <span class="badge bg-warning text-dark mb-2">
                                VIP
                            </span>
                        }

                        @if (table.ReservationId != null)
                        {
                            <div class="mt-3 small">

                                <div>
                                    <strong>Час:</strong>
                                    @table.StartTime?.ToString(@"hh\:mm")
                                    -
                                    @table.EndTime?.ToString(@"hh\:mm")
                                </div>

                                <div>
                                    <strong>Коментар:</strong>
                                    @(string.IsNullOrWhiteSpace(table.Comment)
                                                                ? "—"
                                                                : table.Comment)
                        </div>

                            </div>
                                        }
                        else
                        {
                            <div class="mt-3 text-muted small">
                                Немає активної броні на сьогодні.
                            </div>
                        }

                    </div>

                    <div class="card-footer bg-white d-flex gap-2">

                        @if (table.Status == "Free")
                        {
                            <form action="/Admin/Orders/OpenForTable"
                                  method="post"
                                  class="w-100">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="tableId"
                                       value="@table.TableId" />

                                <button type="submit"
                                        class="btn btn-sm btn-primary w-100">
                                    Відкрити замовлення
                                </button>

                            </form>
                        }
                        else if (table.Status == "Busy"
                        && table.ActiveOrderId != null)
                        {
                            <a href="/Admin/Orders/Details/@table.ActiveOrderId"
                               class="btn btn-sm btn-success w-100">

                                Відкрити чек

                            </a>
                        }
                        else if (table.Status == "Reserved"
                        && table.ReservationId != null)
                        {
                            <div class="d-flex gap-2 w-100">

                                <a href="/Admin/Reservations"
                                   class="btn btn-sm btn-outline-primary w-50">

                                    До броні

                                </a>

                                <form action="/Admin/Orders/OpenFromReservation"
                                      method="post"
                                      class="w-50">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="reservationId"
                                           value="@table.ReservationId" />

                                    <button type="submit"
                                            class="btn btn-sm btn-primary w-100">

                                        Створити чек

                                    </button>

                                </form>

                            </div>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary w-100"
                                    disabled>

                                Недоступно

                            </button>
                        }

                    </div>

                </div>

            </div>
        }

    </div>

</div>