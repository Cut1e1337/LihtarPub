@model Lihtar.Web.Areas.Admin.ViewModels.Users.UsersListVm

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Users";

    var toggleUrl = Url.Action("ToggleBlock", "Users", new { area = "Admin" });
    var deleteUrl = Url.Action("Delete", "Users", new { area = "Admin" });
}

<div class="container py-4">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-0">Users</h2>
            <div class="text-muted small">Manage registered users (block / unblock / delete)</div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-7">
                    <input class="form-control"
                           name="q"
                           value="@Model.Q"
                           placeholder="Search by Email or UserName..." />
                </div>

                <div class="col-md-2">
                    <select class="form-select" name="pageSize">
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="20" selected="@(Model.PageSize == 20)">20</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                        <option value="100" selected="@(Model.PageSize == 100)">100</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button class="btn btn-primary w-100" type="submit">Search</button>
                    <a class="btn btn-outline-secondary w-100" href="/Admin/Users">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width:220px;">Email</th>
                            <th style="min-width:220px;">UserName</th>
                            <th style="min-width:140px;">Roles</th>
                            <th style="min-width:120px;">Status</th>
                            <th class="text-end" style="min-width:240px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Users is null || Model.Users.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    No users found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var u in Model.Users)
                            {
                                <tr>
                                    <td class="fw-semibold">@u.Email</td>
                                    <td class="text-muted">@u.UserName</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(u.Roles))
                                        {
                                            <span class="badge bg-secondary">@u.Roles</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (u.IsBlocked)
                                        {
                                            <span class="badge bg-danger">Blocked</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <form action="@toggleUrl" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <input type="hidden" name="q" value="@Model.Q" />
                                            <input type="hidden" name="page" value="@Model.Page" />
                                            <input type="hidden" name="pageSize" value="@Model.PageSize" />

                                            <button type="submit"
                                                    class="btn btn-sm @(u.IsBlocked ? "btn-success" : "btn-warning")"
                                                    onclick="return confirm('@(u.IsBlocked ? "Unblock this user?" : "Block this user?")');">
                                                @(u.IsBlocked ? "Unblock" : "Block")
                                            </button>
                                        </form>

                                        <form action="@deleteUrl" method="post" class="d-inline ms-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <input type="hidden" name="q" value="@Model.Q" />
                                            <input type="hidden" name="page" value="@Model.Page" />
                                            <input type="hidden" name="pageSize" value="@Model.PageSize" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Delete this user?');">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination mb-0">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link"
                           href="@Url.Action("Index", "Users", new { area = "Admin", q = Model.Q, page = i, pageSize = Model.PageSize })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }

</div>
