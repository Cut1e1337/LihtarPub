@model List<Lihtar.Domain.Entities.EventCategory>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Event Categories";
}

<div class="container py-4">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-0">Event Categories</h2>
            <div class="text-muted small">Create, edit and delete categories for events</div>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="/Admin/Events">Events</a>
            <a class="btn btn-primary" href="/Admin/EventCategories/Create">Create</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th class="text-end" style="width:200px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model is null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                No categories yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var x in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@x.Name</td>
                                <td class="text-muted">@x.Description</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-warning" href="/Admin/EventCategories/Edit/@x.Id">Edit</a>
                                    <a class="btn btn-sm btn-danger" href="/Admin/EventCategories/Delete/@x.Id">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
