@model List<Lihtar.Domain.Entities.Event>

@{
    ViewData["Title"] = "Events";
}

<h2>Events</h2>

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<style>
    .admin-btn {
        display: inline-block;
        padding: 12px 18px;
        margin: 6px 8px 6px 0;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        border: 1px solid #222;
        background: #1f6feb;
        color: #fff;
        cursor: pointer;
    }

        .admin-btn:hover {
            opacity: .9;
        }

        .admin-btn.gray {
            background: #6c757d;
            border-color: #6c757d;
        }

        .admin-btn.green {
            background: #198754;
            border-color: #198754;
        }

        .admin-btn.red {
            background: #dc3545;
            border-color: #dc3545;
        }

        .admin-btn.small {
            padding: 8px 12px;
            font-weight: 600;
            border-radius: 8px;
        }
</style>

<div class="mb-3">
    <a class="admin-btn gray" href="/Admin">⬅ Dashboard</a>
    <a class="admin-btn green" href="/Admin/Events/Create">➕ Create event</a>
    <a class="admin-btn" href="/Admin/EventCategories">🎉 Event categories</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th style="width:180px;">Date</th>
            <th>Title</th>
            <th style="width:220px;">Category</th>
            <th style="width:120px;">Seats</th>
            <th style="width:120px;">Price</th>
            <th style="width:90px;">Active</th>
            <th style="width:260px;"></th>
        </tr>
    </thead>
    <tbody>
        @if (Model is null || Model.Count == 0)
        {
            <tr>
                <td colspan="7">
                    <div class="text-muted">Немає подій. Натисни <b>Create event</b>.</div>
                </td>
            </tr>
        }
        else
        {
            foreach (var x in Model)
            {
                <tr>
                    <td>@x.EventDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@x.Title</td>
                    <td>@(x.EventCategory?.Name ?? "")</td>
                    <td>@x.AvailableSeats / @x.TotalSeats</td>
                    <td>@x.Price</td>
                    <td>@(x.IsActive ? "Yes" : "No")</td>
                    <td>
                        <a class="admin-btn small" href="/Admin/Events/Edit/@x.Id">✏ Edit</a>
                        <a class="admin-btn small red" href="/Admin/Events/Delete/@x.Id">🗑 Delete</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
