@model List<Lihtar.Domain.Entities.Event>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Events";
}

<div class="container py-4">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-0">Events</h2>
            <div class="text-muted small">Manage events, edit, delete, create new</div>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="/Admin">Dashboard</a>
            <a class="btn btn-primary" href="/Admin/Events/Create">Create</a>
            <a class="btn btn-outline-primary" href="/Admin/EventCategories">Categories</a>
        </div>
    </div>

    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger">@err</div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:180px;">Date</th>
                        <th>Title</th>
                        <th style="width:220px;">Category</th>
                        <th style="width:140px;">Seats</th>
                        <th style="width:120px;">Price</th>
                        <th style="width:90px;">Active</th>
                        <th class="text-end" style="width:220px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model is null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No events yet. Click <b>Create</b> to add one.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var x in Model)
                        {
                            <tr>
                                <td>@x.EventDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="fw-semibold">@x.Title</td>
                                <td>@(x.EventCategory?.Name ?? "")</td>
                                <td>@x.AvailableSeats / @x.TotalSeats</td>
                                <td>@x.Price</td>
                                <td>
                                    @if (x.IsActive)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-warning" href="/Admin/Events/Edit/@x.Id">Edit</a>
                                    <a class="btn btn-sm btn-danger" href="/Admin/Events/Delete/@x.Id">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
