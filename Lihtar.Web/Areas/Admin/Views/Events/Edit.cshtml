@model Lihtar.Web.ViewModels.Events.EventEditVm
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Event";

    var categories = Model.Categories ?? new List<SelectListItem>();
    var loadedCount = categories.Count > 0 ? categories.Count - 1 : 0;
}

<h2>Edit Event</h2>

<form method="post" asp-area="Admin" asp-controller="Events" asp-action="Edit" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ImageUrl" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label" for="EventCategoryId">Category</label>

        <select class="form-select" id="EventCategoryId" name="EventCategoryId">
            <option value="">-- Select category --</option>
            @foreach (var c in categories.Where(x => !string.IsNullOrWhiteSpace(x.Value)))
            {
                <option value="@c.Value" selected="@(c.Value == Model.EventCategoryId.ToString())">
                    @c.Text
                </option>
            }
        </select>

        <div class="text-muted small">Loaded categories: @loadedCount</div>
        <span class="text-danger" asp-validation-for="EventCategoryId"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" for="Title">Title</label>
        <input class="form-control" id="Title" name="Title" value="@Model.Title" />
        <span class="text-danger" asp-validation-for="Title"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" for="Description">Description</label>
        <textarea class="form-control" id="Description" name="Description" rows="4">@Model.Description</textarea>
        <span class="text-danger" asp-validation-for="Description"></span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label class="form-label" for="EventDate">Event date</label>
            <input class="form-control"
                   id="EventDate"
                   name="EventDate"
                   type="datetime-local"
                   value="@Model.EventDate.ToString("yyyy-MM-ddTHH:mm")" />
            <span class="text-danger" asp-validation-for="EventDate"></span>
        </div>

        <div class="col-md-4">
            <label class="form-label" for="DurationMinutes">Duration (minutes)</label>
            <input class="form-control"
                   id="DurationMinutes"
                   name="DurationMinutes"
                   type="number"
                   value="@Model.DurationMinutes" />
            <span class="text-danger" asp-validation-for="DurationMinutes"></span>
        </div>

        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       id="IsActive"
                       name="IsActive"
                       value="true"
                       @(Model.IsActive ? "checked" : "") />
                <input type="hidden" name="IsActive" value="false" />
                <label class="form-check-label" for="IsActive">Active</label>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label class="form-label" for="Price">Price</label>
            <input class="form-control" id="Price" name="Price" type="number" step="0.01" value="@Model.Price" />
            <span class="text-danger" asp-validation-for="Price"></span>
        </div>

        <div class="col-md-4">
            <label class="form-label" for="TotalSeats">Total seats</label>
            <input class="form-control" id="TotalSeats" name="TotalSeats" type="number" value="@Model.TotalSeats" />
            <span class="text-danger" asp-validation-for="TotalSeats"></span>
            <div class="text-muted small">Available seats will be recalculated.</div>
        </div>

        <div class="col-md-4">
            <label class="form-label">Available seats</label>
            <input class="form-control" value="@Model.AvailableSeats" readonly />
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        <div class="mb-3">
            <div class="text-muted small mb-1">Current photo:</div>
            <img src="@Model.ImageUrl" style="max-width:260px; border-radius:10px;" />
        </div>
    }

    <div class="mb-3">
        <label class="form-label" for="ImageFile">Replace photo</label>
        <input class="form-control" id="ImageFile" name="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" />
        <span class="text-danger" asp-validation-for="ImageFile"></span>
        <div class="text-muted small">Allowed: jpg / jpeg / png / webp</div>
    </div>

    <button class="btn btn-success" type="submit">Save</button>
    <a class="btn btn-secondary" href="/Admin/Events">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
