@model List<Lihtar.Application.DTOs.MenuCategoryDto>

<h2>Menu Categories</h2>

<p>
    <a asp-area="Admin" asp-controller="MenuCategories" asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>SortOrder</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.SortOrder</td>
                <td>@item.IsActive</td>
                <td>
                    <a asp-area="Admin" asp-controller="MenuCategories" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-area="Admin" asp-controller="MenuCategories" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
