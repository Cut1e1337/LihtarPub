@model List<Lihtar.Application.DTOs.MenuCategoryDto>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Menu Categories</h2>

<p>
    <a class="btn btn-primary" href="/Admin/MenuCategories/Create">Create</a>
</p>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th style="width:120px;">SortOrder</th>
            <th style="width:120px;">Active</th>
            <th class="text-end" style="width:180px;">Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var x in Model)
            {
                <tr>
                    <td>
                        <div class="fw-semibold">@x.Name</div>
                        @if (!string.IsNullOrWhiteSpace(x.Description))
                        {
                            <div class="text-muted small">@x.Description</div>
                        }
                    </td>
                    <td>@x.SortOrder</td>
                    <td>@(x.IsActive ? "Yes" : "No")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-warning" href="/Admin/MenuCategories/Edit/@x.Id">Edit</a>
                        <a class="btn btn-sm btn-danger" href="/Admin/MenuCategories/Delete/@x.Id">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted">No categories yet</td>
            </tr>
        }
    </tbody>
</table>
