@model List<Lihtar.Application.DTOs.MenuCategoryDto>

<h2>Категорії меню</h2>

<p>
    <a class="btn btn-primary" href="/Admin/MenuCategories/Create">+ Додати категорію</a>
</p>

@if (Model == null || !Model.Any())
{
    <p>Поки що немає категорій. Натисни “+ Додати категорію”.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Назва</th>
                <th>SortOrder</th>
                <th>Активна</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var x in Model)
            {
                <tr>
                    <td>@x.Name</td>
                    <td>@x.SortOrder</td>
                    <td>@(x.IsActive ? "Так" : "Ні")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" href="/Admin/MenuCategories/Edit/@x.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" href="/Admin/MenuCategories/Delete/@x.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
