@model Lihtar.Application.DTOs.MenuCategoryDto

<h2>Редагувати категорію</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    <!-- ✅ КРИТИЧНО: без цього dto.Id буде Guid.Empty -->
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Назва</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Опис</label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">SortOrder</label>
        <input asp-for="SortOrder" type="number" class="form-control" />
        <span asp-validation-for="SortOrder" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
        <label asp-for="IsActive" class="form-check-label">Активна</label>
    </div>

    <button class="btn btn-primary" type="submit">Зберегти</button>
    <a class="btn btn-secondary" asp-action="Index">Назад</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
