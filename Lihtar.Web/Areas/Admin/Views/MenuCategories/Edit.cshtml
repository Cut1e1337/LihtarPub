@model Lihtar.Application.DTOs.MenuCategoryDto

<h2>Edit Menu Category</h2>

<form asp-area="Admin" asp-controller="MenuCategories" asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />

    <div>
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div>
        <label>Description</label>
        <input asp-for="Description" class="form-control" />
    </div>

    <div>
        <label>SortOrder</label>
        <input asp-for="SortOrder" class="form-control" />
    </div>

    <div>
        <label>IsActive</label>
        <input asp-for="IsActive" type="checkbox" />
    </div>

    <button type="submit">Save</button>
    <a asp-area="Admin" asp-controller="MenuCategories" asp-action="Index">Back</a>
</form>
