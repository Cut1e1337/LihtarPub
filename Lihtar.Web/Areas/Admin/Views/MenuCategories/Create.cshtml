@model Lihtar.Application.DTOs.MenuCategoryDto

<h2>Додати категорію</h2>

<form method="post" action="/Admin/MenuCategories/Create">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Назва</label>
        <input class="form-control" name="Name" value="@Model?.Name" />
    </div>

    <div class="mb-3">
        <label class="form-label">Опис</label>
        <textarea class="form-control" name="Description" rows="4">@Model?.Description</textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">SortOrder</label>
        <input class="form-control" type="number" name="SortOrder" value="@Model?.SortOrder" />
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="IsActive" value="true" @(Model?.IsActive == true ? "checked" : "") />
        <label class="form-check-label">Активна</label>
    </div>

    <button class="btn btn-success" type="submit">Зберегти</button>
    <a class="btn btn-secondary" href="/Admin/MenuCategories" style="margin-left:8px;">Назад</a>
</form>
