@model Lihtar.Application.DTOs.MenuCategoryDto

<h2>Видалити категорію</h2>

<div class="alert alert-warning">
    Точно видалити категорію: <b>@Model.Name</b> ?
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <button class="btn btn-danger" type="submit">Так, видалити</button>
    <a class="btn btn-secondary" asp-action="Index">Скасувати</a>
</form>
