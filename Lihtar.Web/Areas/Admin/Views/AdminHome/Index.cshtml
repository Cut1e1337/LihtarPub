@{
    ViewData["Title"] = "Головна";
}

<div class="admin-cover">

    <div class="admin-cover-left">
        <span class="admin-cover-badge">Lihtar Admin</span>

        <h2>Панель керування рестораном</h2>

        <p>
            Швидкий доступ до меню, подій, столиків, бронювань
            та користувачів у єдиному зручному просторі.
        </p>

        <div class="admin-cover-actions">
            <a asp-area="Admin" asp-controller="TableBoard" asp-action="Index" class="btn btn-primary">
                Відкрити дошку столиків
            </a>

            <a asp-area="Admin" asp-controller="Reservations" asp-action="Index" class="btn btn-outline-secondary">
                Переглянути бронювання
            </a>
        </div>
    </div>

    <div class="admin-cover-right">
        <div class="admin-cover-card">
            <div class="admin-cover-icon">🍽️</div>
            <h3>Сьогодні</h3>
            <p>Контроль залу, столиків і бронювань</p>
        </div>

        <div class="admin-cover-card">
            <div class="admin-cover-icon">📋</div>
            <h3>Меню</h3>
            <p>Страви, категорії та доступність</p>
        </div>

        <div class="admin-cover-card">
            <div class="admin-cover-icon">🎉</div>
            <h3>Події</h3>
            <p>Афіші, вечори та спеціальні заходи</p>
        </div>

        <div class="admin-cover-card">
            <div class="admin-cover-icon">👤</div>
            <h3>Користувачі</h3>
            <p>Акаунти, ролі та доступи</p>
        </div>
    </div>

</div>