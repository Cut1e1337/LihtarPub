@{
    ViewData["Title"] = "Головна адмінки";
}

<div class="admin-home">

    <div class="admin-hero">
        <div>
            <span class="admin-badge">Адмін-панель Lihtar</span>

            <h2>Керування рестораном</h2>

            <p>
                Тут можна швидко перейти до меню, подій, столиків,
                бронювань та користувачів.
            </p>
        </div>

        <div class="admin-hero-icon">
            🍽️
        </div>
    </div>

    <div class="admin-grid">

        <a class="admin-tile" asp-area="Admin" asp-controller="MenuItems" asp-action="Index">
            <div class="admin-tile-icon">🍕</div>
            <h3>Позиції меню</h3>
            <p>Додавання та редагування страв</p>
        </a>

        <a class="admin-tile" asp-area="Admin" asp-controller="Events" asp-action="Index">
            <div class="admin-tile-icon">🎉</div>
            <h3>Події</h3>
            <p>Керування подіями ресторану</p>
        </a>

        <a class="admin-tile" asp-area="Admin" asp-controller="Tables" asp-action="Index">
            <div class="admin-tile-icon">🪑</div>
            <h3>Столики</h3>
            <p>Налаштування столиків у залі</p>
        </a>

        <a class="admin-tile" asp-area="Admin" asp-controller="TableBoard" asp-action="Index">
            <div class="admin-tile-icon">📋</div>
            <h3>Дошка столиків</h3>
            <p>Статус столиків на сьогодні</p>
        </a>

        <a class="admin-tile" asp-area="Admin" asp-controller="Reservations" asp-action="Index">
            <div class="admin-tile-icon">📅</div>
            <h3>Бронювання</h3>
            <p>Перегляд заявок гостей</p>
        </a>

        <a class="admin-tile" asp-area="Admin" asp-controller="Users" asp-action="Index">
            <div class="admin-tile-icon">👤</div>
            <h3>Користувачі</h3>
            <p>Ролі та акаунти користувачів</p>
        </a>

    </div>

</div>