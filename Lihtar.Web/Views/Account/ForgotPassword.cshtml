@model Lihtar.Web.ViewModels.Account.ForgotPasswordVm

<div class="auth-page">
    <div class="auth-box">
        <div class="auth-brand">
            <div class="auth-brand-icon">L</div>
            <span>Lihtar</span>
        </div>

        <h2>Забули пароль?</h2>
        <p>Введіть email — ми надішлемо посилання для скидання паролю.</p>

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label>Email</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="auth-main-btn">Надіслати</button>

            <p class="text-center mt-3">
                <a asp-action="Login" class="auth-link">Назад до входу</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}