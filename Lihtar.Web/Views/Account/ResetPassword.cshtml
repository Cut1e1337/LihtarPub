@model Lihtar.Web.ViewModels.Account.ResetPasswordVm

<h2>Скидання паролю</h2>

<form asp-action="ResetPassword" method="post">
    @Html.AntiForgeryToken()

    <!-- ВАЖЛИВО: ці два hidden ОБОВʼЯЗКОВІ -->
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Token" />

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-2">
        <label class="form-label">Новий пароль</label>
        <input asp-for="Password" class="form-control" type="password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Підтвердження паролю</label>
        <input asp-for="ConfirmPassword" class="form-control" type="password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Змінити пароль</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
