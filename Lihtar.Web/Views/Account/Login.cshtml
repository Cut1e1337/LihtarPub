@model Lihtar.Web.ViewModels.Account.LoginVm

@{
    Layout = null;
    ViewData["Title"] = "Вхід";
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <title>Вхід - Lihtar</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-page">
        <div class="auth-box">

            <div class="auth-brand">
                <div class="auth-brand-icon">L</div>
                <span>Lihtar</span>
            </div>

            <h2>Вхід</h2>
            <p>Увійдіть, щоб продовжити роботу з рестораном.</p>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label>Email</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label>Пароль</label>
                    <input asp-for="Password" class="form-control" type="password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between mb-4">
                    <label>
                        <input asp-for="RememberMe" class="form-check-input me-1" />
                        Запамʼятати мене
                    </label>

                    <a asp-action="ForgotPassword" class="auth-link">Забули пароль?</a>
                </div>

                <button type="submit" class="auth-main-btn">Увійти</button>

                <p class="text-center mt-3">
                    Немає акаунту?
                    <a asp-action="Register" class="auth-link">Зареєструватися</a>
                </p>
            </form>

        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>