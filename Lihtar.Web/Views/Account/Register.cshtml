@model Lihtar.Web.ViewModels.Account.RegisterVm

@{
    Layout = null;
    ViewData["Title"] = "Реєстрація";
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <title>Реєстрація - Lihtar</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-page">
        <div class="auth-box">

            <div class="auth-brand">
                <div class="auth-brand-icon">L</div>
                <span>Lihtar</span>
            </div>

            <h2>Реєстрація</h2>
            <p>Створіть акаунт для бронювання, оплат і бонусів.</p>

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label>Повне імʼя</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label>Email</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label>Пароль</label>
                    <input asp-for="Password" class="form-control" type="password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label>Підтвердження паролю</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="auth-main-btn">Зареєструватися</button>

                <p class="text-center mt-3">
                    Вже є акаунт?
                    <a asp-action="Login" class="auth-link">Увійти</a>
                </p>
            </form>

        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>