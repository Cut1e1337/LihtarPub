<div class="auth-page">
    <div class="auth-box text-center">
        <div class="auth-brand justify-content-center">
            <div class="auth-brand-icon">L</div>
            <span>Lihtar</span>
        </div>

        <h2>Email не підтверджено</h2>
        <p>Підтвердіть пошту для входу: <b>@ViewBag.Email</b></p>

        <form asp-action="ResendConfirmation" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@ViewBag.Email" />

            <button type="submit" class="auth-main-btn">
                Надіслати лист ще раз
            </button>
        </form>

        <p class="mt-3">
            <a asp-action="Login" class="auth-link">Назад до входу</a>
        </p>
    </div>
</div>