<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lihtar</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <div class="lihtar-shell">

        <aside class="lihtar-sidebar">
            <a class="lihtar-logo" asp-controller="Home" asp-action="Index">
                <div class="lihtar-logo-mark">L</div>
                <span>Lihtar</span>
            </a>

            <nav class="lihtar-nav">

                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                   asp-controller="Home"
                   asp-action="Index">
                    Головна
                </a>

                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Menu" ? "active" : "")"
                   asp-controller="Menu"
                   asp-action="Index">
                    Меню
                </a>

                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "PublicEvents" ? "active" : "")"
                   asp-controller="PublicEvents"
                   asp-action="Index">
                    Події
                </a>

                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservations" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")"
                       asp-controller="Reservations"
                       asp-action="Create">
                        Забронювати столик
                    </a>

                    <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservations" && ViewContext.RouteData.Values["action"]?.ToString() == "My" ? "active" : "")"
                       asp-controller="Reservations"
                       asp-action="My">
                        Мої бронювання
                    </a>

                    <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Payments" ? "active" : "")"
                       asp-controller="Payments"
                       asp-action="SelectTable">
                        Оплата
                    </a>

                    <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Profile" ? "active" : "")"
                       asp-controller="Profile"
                       asp-action="Index">
                        Профіль
                    </a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <a asp-area="Admin"
                       asp-controller="AdminHome"
                       asp-action="Index">
                        Admin
                    </a>
                }

            </nav>
        </aside>

        <div class="lihtar-main">

            <header class="lihtar-topbar">
                <h1 class="lihtar-page-title">
                    @ViewData["Title"]
                </h1>

                <div class="lihtar-top-actions">
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <a class="lh-btn"
                           asp-controller="Profile"
                           asp-action="Index">
                            Профіль
                        </a>

                        <span class="lh-btn">
                            @User.Identity!.Name
                        </span>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()

                            <button type="submit" class="lh-btn">
                                Вийти
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="lh-btn"
                           asp-controller="Account"
                           asp-action="Login">
                            Вхід
                        </a>

                        <a class="lh-btn lh-btn-primary"
                           asp-controller="Account"
                           asp-action="Register">
                            Реєстрація
                        </a>
                    }
                </div>
            </header>

            <main class="lihtar-content">
                @RenderBody()
            </main>

        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>