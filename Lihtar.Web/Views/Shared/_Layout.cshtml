<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lihtar</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="bg-light">

    <!-- ================= NAVBAR ================= -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">

                <!-- LOGO -->
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    Lihtar
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNav"
                        aria-controls="mainNav"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">

                    <!-- LEFT MENU -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active fw-semibold" : "")"
                               asp-controller="Home"
                               asp-action="Index">
                                Головна
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Menu" ? "active fw-semibold" : "")"
                               asp-controller="Menu"
                               asp-action="Index">
                                Меню
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PublicEvents" ? "active fw-semibold" : "")"
                               asp-controller="PublicEvents"
                               asp-action="Index">
                                Події
                            </a>
                        </li>

                        @if (User?.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservations" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active fw-semibold" : "")"
                                   asp-controller="Reservations"
                                   asp-action="Create">
                                    Забронювати столик
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservations" && ViewContext.RouteData.Values["action"]?.ToString() == "My" ? "active fw-semibold" : "")"
                                   asp-controller="Reservations"
                                   asp-action="My">
                                    Мої бронювання
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area="Admin"
                                   asp-controller="AdminHome"
                                   asp-action="Index">
                                    Admin
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- RIGHT SIDE -->
                    <div class="d-flex align-items-center gap-2">

                        @if (User?.Identity?.IsAuthenticated ?? false)
                        {
                            <a class="btn btn-outline-light btn-sm"
                               asp-controller="Profile"
                               asp-action="Index">
                                Профіль
                            </a>

                            <span class="text-light small me-2">
                                @User.Identity!.Name
                            </span>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="d-inline">
                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn btn-outline-light btn-sm">
                                    Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-light btn-sm"
                               asp-controller="Account"
                               asp-action="Login">
                                Login
                            </a>

                            <a class="btn btn-primary btn-sm"
                               asp-controller="Account"
                               asp-action="Register">
                                Register
                            </a>
                        }

                    </div>

                </div>
            </div>
        </nav>
    </header>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="container py-4">
        @RenderBody()
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="border-top bg-white mt-5">
        <div class="container py-3 d-flex justify-content-between small text-muted">
            <div>&copy; @DateTime.Now.Year Lihtar</div>

            <a class="text-muted text-decoration-none"
               asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <!-- scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>