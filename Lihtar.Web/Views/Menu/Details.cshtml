@model Lihtar.Web.ViewModels.Menu.MenuItemDetailsVm

@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-secondary mb-3">
        Назад до меню
    </a>

    <div class="row g-4">
        <div class="col-lg-5">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm" style="width:100%; max-height:420px; object-fit:cover;" />
            }
            else
            {
                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height:320px;">
                    <span class="text-muted">No image</span>
                </div>
            }
        </div>

        <div class="col-lg-7">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                    <h2 class="mb-1">@Model.Name</h2>
                    <div class="text-muted">@Model.CategoryName</div>
                </div>

                <div class="fw-bold fs-4">@Model.Price.ToString("0.00") ₴</div>
            </div>

            <div class="mt-3">
                @if (Model.AverageRating > 0)
                {
                    <div class="fw-semibold">
                        ⭐ @Model.AverageRating.ToString("0.0") / 5
                        <span class="text-muted small">(@Model.ReviewsCount відгуків)</span>
                    </div>
                }
                else
                {
                    <div class="text-muted">Ще немає відгуків</div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="mt-3">@Model.Description</p>
            }

            <div class="small text-muted mt-2">
                @if (Model.WeightGrams.HasValue)
                {
                    <span>@Model.WeightGrams г</span>
                }

                @if (Model.Calories.HasValue)
                {
                    <span class="ms-2">@Model.Calories ккал</span>
                }
            </div>

            @if (Model.Tags.Count > 0)
            {
                <div class="mt-3 d-flex flex-wrap gap-1">
                    @foreach (var tag in Model.Tags)
                    {
                        <span class="badge bg-secondary">@tag</span>
                    }
                </div>
            }

            <div class="mt-4 d-flex gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Menu" asp-action="ToggleFavorite" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="menuItemId" value="@Model.Id" />

                        @if (Model.IsFavorite)
                        {
                            <button type="submit" class="btn btn-danger">Видалити з улюблених</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-outline-danger">Додати в улюблені</button>
                        }
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">
                        Увійти, щоб додати в улюблені
                    </a>
                }
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">Залишити відгук</h5>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Menu" asp-action="AddReview" method="post" class="vstack gap-3">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="menuItemId" value="@Model.Id" />

                            <div>
                                <label class="form-label">Оцінка</label>
                                <select class="form-select" name="rating" required>
                                    <option value="5">5 — Відмінно</option>
                                    <option value="4">4 — Добре</option>
                                    <option value="3">3 — Нормально</option>
                                    <option value="2">2 — Погано</option>
                                    <option value="1">1 — Дуже погано</option>
                                </select>
                            </div>

                            <div>
                                <label class="form-label">Текст відгуку</label>
                                <textarea class="form-control" name="text" rows="4" required></textarea>
                            </div>

                            <button class="btn btn-primary" type="submit">Надіслати</button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-light border mb-0">
                            Щоб залишити відгук, потрібно увійти в акаунт.
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <h5 class="mb-3">Відгуки</h5>

            @if (Model.Reviews.Count == 0)
            {
                <div class="alert alert-light border">Поки що немає відгуків.</div>
            }
            else
            {
                <div class="vstack gap-3">
                    @foreach (var review in Model.Reviews)
                    {
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-3">

                                    <div class="d-flex gap-3">
                                        @if (!string.IsNullOrWhiteSpace(review.UserAvatarUrl))
                                        {
                                            <img src="@review.UserAvatarUrl"
                                                 alt="avatar"
                                                 class="rounded-circle"
                                                 style="width:48px; height:48px; object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                                                 style="width:48px; height:48px; font-weight:700;">
                                                @(string.IsNullOrWhiteSpace(review.UserEmail) ? "U" : review.UserEmail.Substring(0, 1).ToUpper())
                                            </div>
                                        }

                                        <div>
                                            <div class="fw-semibold">
                                                @review.UserEmail
                                            </div>

                                            <div class="small mt-1">
                                                ⭐ @review.Rating / 5
                                            </div>

                                            <div class="text-muted small">
                                                @review.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                            </div>
                                        </div>
                                    </div>

                                    @if (review.IsMine)
                                    {
                                        <form asp-controller="Menu" asp-action="DeleteReview" method="post">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="reviewId" value="@review.Id" />
                                            <input type="hidden" name="menuItemId" value="@Model.Id" />

                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Видалити
                                            </button>
                                        </form>
                                    }
                                </div>

                                <p class="mb-0 mt-3">
                                    @review.Text
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>