@model List<Lihtar.Web.ViewModels.Menu.MenuItemCardVm>

@{
    ViewData["Title"] = "Улюблені страви";
}

<div class="container py-4">
    <h2 class="mb-1">Улюблені страви</h2>
    <div class="text-muted mb-4">Тут зберігаються страви, які ви додали в улюблені.</div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-light border">
            У вас поки немає улюблених страв.
        </div>

        <a asp-controller="Menu" asp-action="Index" class="btn btn-primary">
            Перейти до меню
        </a>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card shadow-sm h-100">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="card-img-top" style="height:180px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height:180px;">
                                <span class="text-muted">No image</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="fw-semibold">@item.Name</div>
                                    <div class="text-muted small">@item.CategoryName</div>
                                </div>
                                <div class="fw-bold">@item.Price.ToString("0.00") ₴</div>
                            </div>

                            @if (item.AverageRating > 0)
                            {
                                <div class="small mt-2">
                                    ⭐ @item.AverageRating.ToString("0.0") / 5
                                    <span class="text-muted">(@item.ReviewsCount)</span>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <div class="text-muted small mt-2" style="min-height:40px;">
                                    @item.Description
                                </div>
                            }

                            <div class="mt-auto pt-3 d-flex gap-2">
                                <a asp-controller="Menu" asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-primary">
                                    Детальніше
                                </a>

                                <form asp-controller="Menu" asp-action="ToggleFavorite" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="menuItemId" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        Видалити
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>