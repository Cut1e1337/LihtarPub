@model Lihtar.Application.DTOs.PaymentDto

@{
    ViewData["Title"] = "Підтвердження оплати";
}

<div class="container py-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">Оплата</h4>
        </div>

        <div class="card-body">
            <p>
                Сума до оплати:
                <strong>@Model.Amount.ToString("0.00") грн</strong>
            </p>

            <form action="/Payments/Confirm" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="paymentId" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label">Номер картки</label>
                    <input name="cardNumber"
                           class="form-control"
                           placeholder="4242 4242 4242 4242"
                           required />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Термін дії</label>
                        <input class="form-control"
                               placeholder="12/30"
                               required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">CVV</label>
                        <input class="form-control"
                               placeholder="123"
                               required />
                    </div>
                </div>

                <button type="submit" class="btn btn-success">
                    Підтвердити оплату
                </button>
            </form>
        </div>
    </div>
</div>