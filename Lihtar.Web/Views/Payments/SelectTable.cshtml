@model List<Lihtar.Web.ViewModels.Payments.SelectTablePaymentVm>

@{
    ViewData["Title"] = "Оплата за столиком";
}

<div class="container py-4">
    <h2 class="mb-3">Оплата за столиком</h2>

    <div class="text-muted mb-4">
        Оберіть свій столик, щоб переглянути чек і оплатити замовлення.
    </div>

    <div class="row g-3">
        @foreach (var table in Model)
        {
            <div class="col-md-4 col-lg-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h4 class="mb-1">Столик №@table.TableNumber</h4>

                        <div class="text-muted small mb-2">
                            @table.Seats місць
                        </div>

                        @if (table.IsVip)
                        {
                            <span class="badge bg-warning text-dark mb-2">VIP</span>
                        }

                        @if (table.ActiveOrderId != null)
                        {
                            <div class="alert alert-success py-2 mt-3">
                                Активний чек:
                                <strong>@table.TotalPrice?.ToString("0.00") грн</strong>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-secondary py-2 mt-3">
                                Немає активного замовлення
                            </div>
                        }
                    </div>

                    <div class="card-footer bg-white">
                        @if (table.ActiveOrderId != null)
                        {
                            <a href="/Payments/Order/@table.ActiveOrderId"
                               class="btn btn-primary w-100">
                                Перейти до оплати
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-secondary w-100" disabled>
                                Недоступно
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>